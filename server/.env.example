# Serveur cible Prospect Pro (lot 1). Copier en .env et remplacer chaque valeur.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://localhost:5432/prospectpro_dev
# 32 caractères au moins : openssl rand -hex 32
JWT_SECRET=
# Développement et tests uniquement (32 octets hexadécimaux : openssl rand -hex 32).
# En recette et en production : VAULT_ADDR et VAULT_TOKEN (moteur Transit, clés prospectpro-<domaine>).
CLE_MAITRESSE_LOCALE=
# VAULT_ADDR=https://vault.interne:8200
# VAULT_TOKEN=

# Installation initiale (npm run installer), à retirer du fichier ensuite.
# Entourer de guillemets toute valeur contenant « # » (sinon la suite est lue comme un commentaire).
ADMIN_IDENTIFIANT=
ADMIN_NOM=
ADMIN_PRENOMS=
ADMIN_TELEPHONE=
ADMIN_MOT_DE_PASSE=
DG_IDENTIFIANT=
DG_NOM=
DG_PRENOMS=
DG_TELEPHONE=
DG_MOT_DE_PASSE=

# Essais uniquement (développement, recette) : identifiants dispensés du second facteur, séparés par des virgules.
# Le serveur refuse de démarrer si cette variable est renseignée en production.
SECOND_FACTEUR_DISPENSE=
