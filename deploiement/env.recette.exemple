# À copier sur le VPS en .env.recette, à côté de docker-compose.recette.yml (chmod 600). Jamais versionné.
# Générer les secrets : openssl rand -hex 32
RECETTE_DB_PASSWORD=
RECETTE_JWT_SECRET=
RECETTE_CLE_MAITRESSE=
RECETTE_PORT=8080
# Essais : comptes connectés sans second facteur (interdit en production)
RECETTE_SECOND_FACTEUR_DISPENSE=admin,direction
# Comptes créés à la première installation (mot de passe : 12 caractères au moins ; entre guillemets s'il contient #)
ADMIN_MOT_DE_PASSE=
DG_MOT_DE_PASSE=
