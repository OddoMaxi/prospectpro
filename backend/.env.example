# Copier ce fichier en .env et remplir les valeurs

PORT=3001
JWT_SECRET=changez_cette_valeur_en_production_32chars_minimum

# --- Développement local (SQLite fichier) ---
# Laisser vide pour utiliser la base locale

# --- Production (Turso) ---
# TURSO_DATABASE_URL=libsql://votre-db.turso.io
# TURSO_AUTH_TOKEN=votre_token_turso

# --- CORS ---
# En production, mettre l'URL de votre frontend Vercel
# ALLOWED_ORIGINS=https://votre-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
