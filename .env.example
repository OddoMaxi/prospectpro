# Copier ce fichier en .env sur le VPS et remplir les valeurs
# Ne jamais committer .env dans git

# Mot de passe PostgreSQL (choisir un mot de passe fort)
DB_PASSWORD=ChangeThis_MotDePasseFort123!

# Clé secrète JWT (générer avec : openssl rand -hex 64)
JWT_SECRET=remplacer_par_une_chaine_aleatoire_longue

# Domaine autorisé pour les requêtes frontend (CORS)
ALLOWED_ORIGINS=https://ton-domaine.com
